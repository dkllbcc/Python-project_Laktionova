import math

def calculate_cos_approximation():
    print(«— Задание 1: Приближенное значение cos(X) —«)
    while True:
        try:
            x = float(input(«Введите вещественное число X (например, 1.5): «))
            n = int(input(«Введите целое число N (>0): «))
            
            if n <= 0:
                print(«Ошибка: N должно быть больше нуля. Попробуйте снова.»)
                continue
                
            total = 0.0
            
            # Считаем сумму по формуле
            for i in range(n + 1):
                sign = (-1) ** i
                numerator = x ** (2 * i)
                denominator = math.factorial(2 * i)
                total += sign * (numerator / denominator)
                
            print(f»Приближенное значение cos({x}): {total:.6f}»)
            print(f»Реальное значение через math.cos: {math.cos(x):.6f} (для проверки)»)
            break
            
        except ValueError:
            print(«Ошибка: вводите числа. X может быть дробным, N — только целым. Попробуйте снова.»)

